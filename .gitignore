# Dependencies
node_modules/

# Environment variables & secrets (絶対コミット禁止)
.env
.env.*
.my.env
.my.env.*
!.my.env.sample
*.env
*.key
*.pem
firebase*.json
*.secret

# Generated audio files
*.wav
*.mp3
public/voice/*
!public/voice/.gitkeep

# Persistent user data (スケジュール内容・履歴)
data/*
!data/.gitkeep

# OS and Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/

# Logs and scratch backups
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.bak
*.patch
test_*.mp3

