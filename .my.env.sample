# TimeZone
TZ=Asia/Tokyo

# Server Configuration
SERVER_PORT=8080
WIRELESS_IP=192.168.11.xxx
WIRELESS_MODULE_NAME=ens192

# Default Google Home / Nest device IP
GOOGLE_HOME_IP=192.168.11.xxx

# Edge TTS Default Voice (Nanami: 女性, Keita: 男性, etc.)
DEFAULT_VOICE=ja-JP-NanamiNeural

# 音声キャッシュ上限 (MB) - デフォルト 1024MB (1GB)
MAX_CACHE_SIZE_MB=1024

# Cloudflare Tunnel ドメイン (設定すると Web GUI の Webhook ガイドに外部用 URL が反映されます)
# CLOUDFLARE_TUNNEL_DOMAIN=webhook.kit-a.net

# Cloudflare Tunnel コネクタトークン (cloudflared コンテナ用)
TUNNEL_TOKEN=eyJh...
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# Cloudflare Tunnel / External Webhook Protection Token (Optional)
# WEBHOOK_TOKEN=your-secret-token-here

# Alexa (Amazon Echo) 連携設定 (任意)
ALEXA_ENABLED=false
ALEXA_AMAZON=amazon.co.jp
ALEXA_ALEXA=alexa.amazon.co.jp
ALEXA_EMAIL=
ALEXA_PASSWORD=
ALEXA_MFA_SECRET=
ALEXA_DEFAULT_DEVICE=ALL
