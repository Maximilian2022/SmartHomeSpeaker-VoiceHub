# ========================================
# Smart Home Speaker Voice Hub 環境設定サンプル
# 本ファイルをコピーして .my.env を作成してください
# ========================================

# タイムゾーン
TZ=Asia/Tokyo

# サーバー待受ポート (デフォルト: 8080)
# PORT または SERVER_PORT で指定可能です
PORT=8080
# SERVER_PORT=8080

# サーバーIPアドレス (未指定時は LAN 内の IP アドレスが自動検出されます)
# SERVER_IP=192.168.1.100

# デフォルトの Google Home / Nest デバイス IP (未指定時は mDNS で自動検出)
# GOOGLE_HOME_IP=192.168.1.50

# Edge TTS デフォルト話者 (Nanami: 女性, Keita: 男性 等)
DEFAULT_VOICE=ja-JP-NanamiNeural

# 音声キャッシュ上限 (MB) - デフォルト 1024MB (1GB)
MAX_CACHE_SIZE_MB=1024

# Cloudflare Tunnel 連携 (外部から Webhook を呼び出す場合)
# CLOUDFLARE_TUNNEL_DOMAIN=webhook.example.com
# TUNNEL_TOKEN=eyJh...

# Webhook 外部アクセス認証トークン (設定すると Authorization: Bearer <TOKEN> が必須になります)
# WEBHOOK_TOKEN=your-secret-token-here

# Alexa (Amazon Echo) 連携 (任意: 有効にする場合は true に設定)
ALEXA_ENABLED=false
ALEXA_AMAZON=amazon.co.jp
ALEXA_ALEXA=alexa.amazon.co.jp
ALEXA_DEFAULT_DEVICE=ALL

# AI 連携設定 (任意: DND保留通知のAI要約・スマートアナウンス機能用)
# Google Gemini API Key (推奨: https://aistudio.google.com/ で無料取得可能)
# GEMINI_API_KEY=your-gemini-api-key-here
# または OpenAI API Key (https://platform.openai.com/ で取得)
# OPENAI_API_KEY=your-openai-api-key-here

